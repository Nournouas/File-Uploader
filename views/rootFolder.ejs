<html>
  <%- include("partials/head", {title: "Folders - File Uploader"})%>
  <main>
    <h1>welcome <%= user.email %></h1>
    <br>
    <br>
    <h1>Folders</h1>
    <h3>Create New Folder</h3>
    <form action="/folders/newfolder" method="POST">
      <input type="text", name="userId", value="<%= user.id %>" hidden/>
      <input type="text", name="folderId", value="<%= folders[0].id %>" hidden/>
      <label for="folderName">Folder Name</label>
      <input id="folderName" type="text" name="folderName" />
      <button type="submit">Create Folder</button>
    </form>
    <br>
    <br>
    <% for (let i = 0 ; i < folders.length ; i++) { %>
      <% if (folders[i].name != "Root") { %>
      <div>
        <h2><%= folders[i].name %></h2>
        <a href=<%=`/folders/${folders[i].id}`%>>Visit</a>
      </div>
      <% } %>
    <% } %>
    <br>
    <br>
    <br>
    <h1>Files</h1>
    <h3>Upload New File to <%= folders[0].name %></h3>
    <form action="/folders/uploadfile" method="POST" enctype="multipart/form-data">
      <input type="text", name="user", value="<%= user.id %>" hidden/>
      <input type="file" name="file" />
      <button type="submit">upload</button>
    </form>
    <br>
    <br>
    <br>
    <% if (rootFolder.files){ %>
      <% for (let i = 0 ; i < rootFolder.files.length ; i++) { %>
        <div>
          <h2><%= rootFolder.files[i].fileUrl %></h2>
        </div>
      <% } %>
    <% } %>
    <a href="/logout">logout</a>
  </main>
</html>